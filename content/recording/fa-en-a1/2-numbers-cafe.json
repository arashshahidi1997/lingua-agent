   "cue": "Narrator"
  },
  {
   "n": 35,
   "text": "سارا دانشجو است. کلاس او ساعت هشت است.",
   "tr": "Sârâ dâneshju ast. kelâs-e u sâ'at-e hasht ast.",
   "gloss": "Sara is a student. Her class is at eight.",
   "refs": [
    "line:s-u5-saras-week-2"
   ],
   "section": "Sara's week (story)",
   "cue": "Narrator"
  },
  {
   "n": 36,
   "text": "در کلاس سارا بیست و پنج دانشجو هست.",
   "tr": "dar kelâs-e Sârâ bist-o panj dâneshju hast.",
   "gloss": "There are twenty-five students in Sara's class.",
   "refs": [
    "line:s-u5-saras-week-3"
   ],
   "section": "Sara's week (story)",
   "cue": "Narrator"
  },
  {
   "n": 37,
   "text": "علی دکتر است. او از شنبه تا چهارشنبه سر کار است.",
   "tr": "Ali doktor ast. u az shanbe tâ chahârshanbe sar-e kâr ast.",
   "gloss": "Ali is a doctor. He is at work from Saturday to Wednesday.",
   "refs": [
    "line:s-u5-saras-week-4"
   ],
   "section": "Sara's week (story)",
   "cue": "Narrator"
  },
  {
   "n": 38,
   "text": "جمعه روز تعطیل است.",
   "tr": "jom'e ruz-e ta'til ast.",
   "gloss": "Friday is the day off.",
   "refs": [
    "line:s-u5-saras-week-5"
   ],
   "section": "Sara's week (story)",
   "cue": "Narrator"
  },
  {
   "n": 39,
   "text": "جمعه ساعت ده، سارا و علی و مریم در کافه هستند.",
   "tr": "jom'e sâ'at-e dah, Sârâ va Ali va Maryam dar kâfe hastand.",
   "gloss": "On Friday at ten, Sara, Ali and Maryam are at the café.",
   "refs": [
    "line:s-u5-saras-week-6"
   ],
   "section": "Sara's week (story)",
   "cue": "Narrator"
  },
  {
